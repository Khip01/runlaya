# runlaya environment variables
# Copy this file to .env and fill in the values.

# Token Bearer untuk autentikasi API (wajib)
API_TOKEN=

# Port server (opsional, default 3000)
PORT=3000

# Path ke direktori model (opsional, default: ./models/)
# Setiap subfolder di direktori ini = satu model terdaftar.
# MODELS_DIR=
